{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@middleware/*": [
        "src/middleware/*"
      ]
    }
  },
  "include": [
    "src",
    "public/assets/js",
    "public/assets/js/index.js"
  ]
}